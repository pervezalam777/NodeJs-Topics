NODE_ENV=development
PORT=3000

# Leave DATABASE_URL empty for local dev -> embedded PGlite (real Postgres in WASM, data in ./data/pglite)
# Set it to use a real PostgreSQL server (docker compose does this for you)
DATABASE_URL=
PGLITE_DIR=./data/pglite

# Use long random strings (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=dev-access-secret-change-me-dev-access-secret
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me-dev-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Set to false when serving over plain http (e.g. docker on localhost)
COOKIE_SECURE=false
